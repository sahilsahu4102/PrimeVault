# Server
PORT=5000
NODE_ENV=development

# Database
# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/primevault"

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CLIENT_URL=http://localhost:5173

# Production: set NODE_ENV=production (Secure + SameSite=None cookie, hidden error details). CLIENT_URL must list the client origin.

# Proxies in front of the API (Express "trust proxy"). Production defaults to 1; set 2 if a CDN sits in front of the host's load balancer.
# Without it, every visitor behind a proxy shares one rate-limit bucket.
# TRUST_PROXY=1
